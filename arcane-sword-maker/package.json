  "version": "0.0.0",
  "type": "module",
  "scripts": {
      "comment-check": "node ./comment-check.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "push": "butler push dist/ creativecraving/arcane-sword-maker:2026-Q1-demo",
